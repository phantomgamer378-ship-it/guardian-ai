# CyberGuard AI Environment Variables

# Required: Groq API Key
GROQ_API_KEY=your_groq_api_key_here

# Optional: Database
DATABASE_URL=sqlite:///./cyberguard.db
# For PostgreSQL: DATABASE_URL=postgresql://user:password@localhost:5432/cyberguard

# Optional: Security
SECRET_KEY=your-secret-key-here-change-in-production

# Optional: Admin Settings
ADMIN_API_KEY=admin-secret-key-for-dashboard-access
